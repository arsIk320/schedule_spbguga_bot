# Токен из @BotFather. Никому его не отправляйте.
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
# Сначала 0: бот подскажет ваш ID по /id. Затем замените и перезапустите.
OWNER_ID=0
DEFAULT_TIMEZONE=Europe/Moscow
# Для Cloudflare: придумайте случайный секрет из 32+ латинских букв/цифр.
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARACTERS
